@startuml G07 - Modelo de Datos Integrado
title G07 - Modelo de Datos Integrado (DER) - WardrobeFlow
' Integracion de los modelos parciales. Balanceado con BD/01_Crear_BaseDeDatos.sql.
' NEGOCIO (amarillo) vs TECNICO/infraestructura (celeste).

skinparam shadowing false
hide circle
skinparam linetype ortho

' ===================== NEGOCIO =====================
entity Usuario #FFF7CC {
  * IdUsuario : int <<PK>>
  --
  Username : nvarchar(100) <<UQ>>
  Clave : nvarchar(500)  ' hash PBKDF2
  Rol : nvarchar(100)
  Perfil : nvarchar(100)
  Estado : bit
  IntentosFallidos : int
  Nombre / Apellido / Email / FechaNacimiento
  Activo : bit
  DVH : int  ' T07
  IdIdioma : varchar(5)
}

entity Empleado #FFF7CC {
  * IdEmpleado : int <<PK>>
  --
  Nombre / Apellido
  DNI : nvarchar(200)  ' cifrado AES
  Puesto / Legajo / Email
  IdUsuario : int <<FK>>
  DVH : int  ' T07
}

entity Cliente #FFF7CC {
  * IdCliente : int <<PK>>
  --
  Nombre / Apellido
  DNI : nvarchar(200)  ' cifrado AES
  Email / MetodoPago / FechaNacimiento
  IdPlan : int <<FK>>
  Activo : bit
  DVH : int  ' T07
}

entity PlanSuscripcion #FFF7CC {
  * IdPlan : int <<PK>>
  --
  Nombre / LimitePrendas / Precio / Estado
}

entity Prenda #FFF7CC {
  * IdPrenda : int <<PK>>
  --
  Nombre / Descripcion / Talle / Color / Categoria
  Estado : int
  IdClienteActual : int <<FK>>
}

entity Pedido #FFF7CC {
  * IdPedido : int <<PK>>
  --
  IdCliente : int <<FK>>
  IdEmpleado : int <<FK>>
  Estado : int
  FechaPedido / FechaDespacho / FechaEntrega
  DVH : int  ' T07 (incluye huella de sus lineas)
}

entity PedidoPrenda #FFF7CC {
  * IdPedido : int <<PK,FK>>
  * IdPrenda : int <<PK,FK>>
}

entity PedidoHistorial #FFF7CC {
  * IdHistorial : int <<PK>>
  --
  IdPedido : int <<FK>>
  IdUsuario : int <<FK>>
  Accion / Campo
  ValorAnterior / ValorNuevo  ' T06b control de cambios
  Fecha : datetime
}

entity MantenimientoPrenda #FFF7CC {
  * IdMantenimiento : int <<PK>>
  --
  IdPrenda : int <<FK>>
  FechaEntrada / FechaSalida / Estado
}

' ===================== PERMISOS / COMPOSITE (T04) =====================
entity Permiso #FFF7CC {
  * IdPermiso : int <<PK>>
  --
  Nombre / NombreMenu / TipoComponente
  EsFamilia : bit
  EsRol : bit
  Estado : bit
}

entity PermisoRelacion #FFF7CC {
  * IdPadre : int <<PK,FK>>
  * IdHijo : int <<PK,FK>>
  ' auto-relacion -> arbol Composite
}

entity RolPermiso #FFF7CC {
  * Rol : nvarchar(100) <<PK>>
  * IdPermiso : int <<PK,FK>>
  ' legacy / seed-bootstrap
}

entity ControlMapeado #DDF3FF {
  * IdControlMapeado : int <<PK>>
  --
  IdPermiso : int <<FK>>
  Formulario / NombreControl
}

' ===================== MULTIIDIOMA (T05) =====================
entity Idioma #FFF7CC {
  * IdIdioma : int <<PK>>
  --
  Codigo : varchar(5) <<UQ>>
  Nombre / Activo / EsDefault
}

entity Control #FFF7CC {
  * IdControl : int <<PK>>
  --
  Clave : varchar(100) <<UQ>>
  Formulario
}

entity Traduccion #FFF7CC {
  * IdControl : int <<PK,FK>>
  * IdIdioma : int <<PK,FK>>
  --
  Texto : nvarchar(1000)
}

' ===================== TECNICO / INFRAESTRUCTURA =====================
entity Bitacora #DDF3FF {
  * Id : int <<PK>>
  --
  fecha : datetime
  usuario : int <<FK>>
  modulo / actividad / detalle
  criticidad : int
  ip : nvarchar(50)
}

entity BitacoraNegocio #DDF3FF {
  * IdEvento : int <<PK>>
  --
  Fecha / Tipo / Descripcion
  IdUsuario / IdPedido / IdPrenda / IdCliente <<FK>>
}

entity HistorialUsuario #DDF3FF {
  * IdVersion : int <<PK>>
  --
  IdUsuario : int <<FK>>
  Fecha / Actor / Detalle
  *Snapshot ...  ' T06b Memento
}

entity DVVertical #DDF3FF {
  * Id : int <<PK>>
  --
  NombreTabla : varchar(100) <<UQ>>
  DVV : int
  FechaCalculo : datetime
}

entity HistorialIntegridad #DDF3FF {
  * Id : int <<PK>>
  --
  NombreTabla / DVVAlmacenado / DVVCalculado
  Resultado : bit
  FilasCorruptas : int
  DisparadoPor : varchar(50)
}

entity Usuario_Seguridad #DDF3FF {
  * IdUsuario : int <<PK>>
  --
  Username / Clave / Rol / Perfil / Estado
  ' tabla espejo para recuperacion (T07)
}

entity ClaveRecuperacion #DDF3FF {
  * IdClave : int <<PK>>
  --
  ClaveHash : nvarchar(500)
  Usada : bit / UsadaPor / FechaUso
}

entity Preferencia #DDF3FF {
  * IdUsuario : int <<PK,FK>>
  --
  FuenteFamilia / FuenteTamano / Tema / FormatoFecha
}

' ===================== RELACIONES =====================
PlanSuscripcion ||--o{ Cliente
Cliente ||--o{ Prenda
Cliente ||--o{ Pedido
Empleado ||--o{ Pedido
Usuario ||--o| Empleado
Pedido ||--o{ PedidoPrenda
Prenda ||--o{ PedidoPrenda
Pedido ||--o{ PedidoHistorial
Prenda ||--o{ MantenimientoPrenda
Usuario ||--o{ PedidoHistorial

Permiso ||--o{ PermisoRelacion : IdPadre
Permiso ||--o{ PermisoRelacion : IdHijo
Permiso ||--o{ RolPermiso
Permiso ||--o{ ControlMapeado

Idioma ||--o{ Traduccion
Control ||--o{ Traduccion

Usuario ||--o{ Bitacora
Usuario ||--o{ BitacoraNegocio
Usuario ||--o{ HistorialUsuario
Usuario ||--|| Preferencia

note as N1 #FFFFCC
  Amarillo = tablas de NEGOCIO.
  Celeste  = tablas TECNICAS / de
  infraestructura (auditoria, DV,
  i18n runtime, recuperacion, prefs).
  Diseno normalizado (3FN) con
  integridad referencial (FKs).
end note
@enduml
