<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Clave Maestra de Recuperación para ConfirmarAdminForm (autoriza sin usuario).
             Guardar acá el HASH PBKDF2 (Seguridad.Encriptador.Hash) de la clave, NO la clave en texto.
             Vacío = función desactivada (solo se autoriza con credenciales de Administrador). -->
        <add key="MasterRecoveryKeyHash" value="XjqoPQnW0+k9F7V5FEmBp/3Pxep9GTfJmz1wHpSGXXBkdc7DXw3dBpUzYrmBNvTu" />
    </appSettings>
    <connectionStrings>
        <add name="WardrobeFlowDB"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=WardrobeFlowDB;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>